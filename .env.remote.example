# Copy to .env.remote, NOT .env. Never commit the resulting file.
APP_IMAGE=classmates-explorer:remote-v1
# Configure the API domain and HTTPS certificate in 1Panel / OpenResty.
ALLOWED_ORIGINS=["https://your-account.github.io"]
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Preserve across restarts; changing this key makes previous tasks inaccessible.
SESSION_SECRET=
