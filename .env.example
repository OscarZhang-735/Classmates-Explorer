APP_MODE=local
# Public-data-only GitHub token. Never commit a real token.
GITHUB_TOKEN=
UNLIMITED_MODE=false
DATABASE_URL=sqlite:///./explorer.sqlite3
MAX_FORKS=1000
MAX_IMPORT_BYTES=10485760
MAX_QUEUED_TASKS=5
SUBMISSIONS_PER_MINUTE=5
GITHUB_REQUEST_INTERVAL=1
CONTRIBUTION_BATCH_SIZE=10
CONNECT_TIMEOUT=5
REQUEST_TIMEOUT=20
MAX_RETRIES=3
MAX_TASK_REQUESTS=300
MAX_TASK_POINTS=500
RATE_LIMIT_RESERVE=100
MAX_CONSECUTIVE_RATE_LIMITS=5
RESULT_CACHE_SECONDS=3600
OWNER_CACHE_SECONDS=86400
CONTRIBUTION_CACHE_SECONDS=21600
